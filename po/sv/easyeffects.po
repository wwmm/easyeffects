#: src/autostart.cpp:92
msgid ""
"Cannot enable autostart option because background access has been denied. "
"Please allow \"Run in Background\" permission for Easy Effects in your "
"system app settings."
msgstr ""
"Det går inte att aktivera automatisk start eftersom Easy Effects inte får "
"köras i bakgrunden. Ge Easy Effects behörigheten ”Kör i bakgrunden” i "
"systemets programinställningar."

#: src/command_line_parser.cpp:44
msgid "Quit Easy Effects. Useful when running in service mode."
msgstr "Avsluta Easy Effects. Användbart när programmet körs som tjänst."

#: src/command_line_parser.cpp:45
msgid "Reset Easy Effects."
msgstr "Återställ Easy Effects."

#: src/command_line_parser.cpp:46
msgid "Hide the window."
msgstr "Dölj fönstret."

#: src/command_line_parser.cpp:49
msgid ""
"Global bypass. 1 to enable, 2 to disable and 3 to get the current state."
msgstr ""
"Global förbikoppling. Ange 1 för att aktivera, 2 för att inaktivera eller 3 "
"för att visa aktuell status."

#: src/command_line_parser.cpp:50
msgid "bypass-state"
msgstr "förbikopplingsläge"

#: src/command_line_parser.cpp:52
msgid "Toggle the state of the global bypass."
msgstr "Slå på eller av global förbikoppling."

#: src/command_line_parser.cpp:55
msgid ""
"Audio sharing. 1 to enable, 2 to disable and 3 to get the current state."
msgstr ""
"Ljuddelning. Ange 1 för att aktivera, 2 för att inaktivera eller 3 för att "
"visa aktuell status."

#: src/command_line_parser.cpp:56 src/command_line_parser.cpp:62
msgid "state"
msgstr "läge"

#: src/command_line_parser.cpp:58
msgid "Toggle the state of audio sharing."
msgstr "Slå på eller av ljuddelning."

#: src/command_line_parser.cpp:61
msgid ""
"Microphone monitoring. 1 to enable, 2 to disable and 3 to get the current "
"state."
msgstr ""
"Medhörning av mikrofonen. Ange 1 för att aktivera, 2 för att inaktivera "
"eller 3 för att visa aktuell status."

#: src/command_line_parser.cpp:64
msgid "Toggle the state of microphone monitoring."
msgstr "Slå på eller av medhörning av mikrofonen."

#: src/command_line_parser.cpp:65
msgid "Load a preset. Example: easyeffects -l music"
msgstr "Läs in en förinställning. Exempel: easyeffects -l music"

#: src/command_line_parser.cpp:65
msgid "preset-name"
msgstr "förinställningsnamn"

#: src/command_line_parser.cpp:66
msgid "Show available presets."
msgstr "Visa tillgängliga förinställningar."

#: src/command_line_parser.cpp:67
msgid "Get the last loaded input/output preset."
msgstr "Hämta den senast inlästa förinställningen för ingång eller utgång."

#: src/command_line_parser.cpp:67
msgid "preset-type"
msgstr "förinställningstyp"

#: src/command_line_parser.cpp:68
msgid "Get the last loaded input and output presets."
msgstr "Hämta de senast inlästa förinställningarna för ingång och utgång."

#: src/command_line_parser.cpp:69
msgid "Deprecated. Use --service-mode instead."
msgstr "Föråldrat alternativ. Använd --service-mode i stället."

#: src/command_line_parser.cpp:70
msgid "Start the application with service mode turned on."
msgstr "Starta programmet i tjänsteläge."

#: src/command_line_parser.cpp:71
msgid "Enable debug messages."
msgstr "Aktivera felsökningsmeddelanden."

#: src/command_line_parser.cpp:144
msgid "Must specify preset type: input/output."
msgstr "Ange förinställningstyp: input eller output."

#: src/command_line_parser.cpp:178
msgid "Output presets"
msgstr "Förinställningar för utgång"

#: src/command_line_parser.cpp:180
msgid "No output presets."
msgstr "Inga förinställningar för utgång."

#: src/command_line_parser.cpp:191
msgid "Input presets"
msgstr "Förinställningar för ingång"

#: src/command_line_parser.cpp:193
msgid "No input presets."
msgstr "Inga förinställningar för ingång."

#: src/command_line_parser.cpp:223
msgid "Specified preset does not exist."
msgstr "Den angivna förinställningen finns inte."

#: src/command_line_parser.cpp:243
msgid "Provided an invalid bypass state."
msgstr "Ogiltigt läge för förbikoppling."

#: src/command_line_parser.cpp:283
msgid "Provided an invalid microphone monitoring state."
msgstr "Ogiltigt läge för medhörning av mikrofonen."

#: src/command_line_parser.cpp:313
msgid "Provided an invalid audio sharing state."
msgstr "Ogiltigt läge för ljuddelning."

